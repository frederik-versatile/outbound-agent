# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# One Apollo.io API key per customer deployment. The env var name referenced
# by config/deployments/<deployment_id>.yaml is apollo_api_key_env, which
# must match one of these.
APOLLO_API_KEY_EXAMPLE=...

# dashboard.py basic-auth credentials (local dev). In production these are
# set as sync:false env vars in the Render dashboard, not committed here.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
